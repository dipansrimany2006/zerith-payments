{
  "name": "zerith",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "bun run ./server/relayer.ts",
    "relayer": "bun run ./server/relayer.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src server worker scripts",
    "zk:setup": "bash ./near/zk/setup.sh",
    "zk:fixture": "node near/zk/gen-fixture.ts build/circuits/transaction_js/transaction.wasm build/zk-groth16/transaction.zkey build/zk-groth16/transaction_vk.json near/contracts/pool/tests/fixtures/transact.json",
    "near:build": "bash ./near/scripts/build.sh",
    "near:test": "cd near && cargo test -p zerith-pool -- --nocapture",
    "e2e:testnet": "node scripts/near-e2e.ts",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "e2e:payroll": "node scripts/near-payroll-e2e.ts",
    "ai:check": "bun scripts/near-ai-check.ts"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@phala/dcap-qvl": "0.7.1",
    "circomlib": "^2.0.5",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "near-api-js": "7.5.3",
    "poseidon-lite": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snarkjs": "^0.7.6",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "wrangler": "^4.156.0"
